# Plantilla de configuracion. Copiar este archivo como .env y completar.
# El .env real NO se commitea nunca: esta en el .gitignore.
#
#   copy env.ejemplo .env     (Windows)
#   cp  env.ejemplo .env      (Linux / Mac)

PORT=3000

# Login de SQL Server: usuario y contrasena, no autenticacion de Windows.
# El driver de Node (mssql/tedious) no soporta autenticacion integrada,
# asi que aunque entres a SSMS con tu usuario de Windows, el back necesita
# un login SQL. Cada integrante usa el de su propia maquina.
DB_USER=sa
DB_PASSWORD=

# Servidor y puerto. Con SQL Express en la misma maquina, localhost y el
# puerto 1433 alcanzan.
DB_SERVER=localhost
DB_PORT=1433

# Base donde corriste db/script.sql. El script no crea la base ni tiene USE:
# hay que seleccionarla a mano en SSMS antes de ejecutarlo.
DB_NAME=Boliche.RobertBertinoSuarez

# No agregar DB_INSTANCE. Si el driver recibe un nombre de instancia, ignora
# el puerto de arriba y le pregunta al servicio SQL Server Browser en que
# puerto escucha esa instancia. Ese servicio suele venir detenido, y entonces
# la conexion falla recien a los 15 segundos con:
#   Failed to connect to localhost\SQLEXPRESS in 15000ms

DB_ENCRYPT=false
DB_TRUST_CERT=true
